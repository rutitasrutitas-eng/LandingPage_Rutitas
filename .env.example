# Déjalo vacío hasta que la ficha pública y oficial de Rutitas esté disponible.
# Solo se aceptan URLs HTTPS de play.google.com/store/apps/details con parámetro id.
VITE_GOOGLE_PLAY_URL=

# Compatibilidad temporal con el nombre usado por la tarjeta QR anterior.
# Solo se usará si también es una ficha oficial válida de Google Play.
VITE_APP_URL=

# Measurement ID real de GA4 (formato G-XXXXXXXXXX). Sin valor no se carga Analytics.
# La etiqueta se carga únicamente después del consentimiento afirmativo del visitante.
VITE_GA_MEASUREMENT_ID=
